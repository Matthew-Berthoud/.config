export REPOS="$HOME/repos"
export WORK_REPOS="$REPOS/black-cape"
export CONFIG="$HOME/.config"
export SCRIPTS="$CONFIG/scripts"
export WORKFLOW="$SCRIPTS/workflow"
export NOTES="$HOME/Desktop/notes"
